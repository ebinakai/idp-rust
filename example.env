# --- DB / Docker (MySQL & phpMyAdmin) ---
MYSQL_ROOT_PASSWORD=root_pass_here
MYSQL_DATABASE=idp-app
MYSQL_PORT=3306
PMA_PORT=8080

# --- IdP Server (server) ---
DATABASE_URL=mysql://root:[password_here]@[hostname_here]:[port_here]/[database_name_here]?ssl_mode=DISABLED
ISSUER=http://localhost:3000
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_USERNAME=
ALLOW_SELF_REGISTER=false

# --- 検証用クライアント (client_app) ---
IDP_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:4000
